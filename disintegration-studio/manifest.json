{
  "manifestVersion": 5,
  "id": "com.claxo.disintegrationstudio",
  "name": "Disintegration Studio",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "plugin"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "openStudio",
      "label": {
        "default": "Open Disintegration Studio\u2026"
      }
    },
    {
      "type": "command",
      "id": "quickDisintegrate",
      "label": {
        "default": "Quick Disintegrate"
      }
    },
    {
      "type": "command",
      "id": "newBrushTip",
      "label": {
        "default": "New Brush Tip from Selection or Layer"
      }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
